{
   "action": {
      "default_icon": {
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png"
      },
      "default_title": "Prism — Design Inspector"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": [ "capture-bridge.js" ],
         "matches": [ "http://localhost/*", "http://127.0.0.1/*", "https://mesurer.dev/*" ],
         "run_at": "document_start"
      },
      {
         "js": [ "panel.js" ],
         "matches": [ "<all_urls>" ],
         "run_at": "document_idle"
      }
   ],
   "description": "Inspect spacing, measure layouts, annotate — plus extract colors, typography and assets from any site. Powered by Mesurer + design token intelligence.",
   "host_permissions": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://mesurer.dev/*",
      "<all_urls>"
   ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "manifest_version": 3,
   "name": "Prism — Design Inspector, Measurer & Token Extractor",
   "permissions": [ "activeTab", "scripting", "storage", "clipboardWrite" ],
   "version": "0.1.5"
}
